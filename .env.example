# Supabase Project URL and publishable key. Nitro uses both on the server.
NUXT_SUPABASE_URL=https://your-project.supabase.co
NUXT_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Trusted origin used to generate email links. Use HTTPS for hosted deployments.
NUXT_SITE_URL=http://localhost:3000

# Optional contact fallback if the commercial settings have no WhatsApp number.
NUXT_PUBLIC_WHATSAPP_NUMBER=

# Optional, available in Nuxt development mode only.
NUXT_PUBLIC_STOREFRONT_MOCK=false
